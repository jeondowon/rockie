{
  "name": "rockie-desktop-pet",
  "version": "1.0.4",
  "description": "화면 위에 사는 데스크톱 애완돌. 마우스를 따라다니고 활성 앱에 반응하며 성향 질문으로 진화합니다.",
  "main": "src/main/main.js",
  "author": "jeondowon <dowon.9102@gmail.com>",
  "homepage": "https://jeondowon.com/rockie",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeondowon/rockie.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "dev": "DEV_RELOAD=1 electron .",
    "test": "node --test",
    "notices": "node scripts/gen-notices.js",
    "dist": "electron-builder --mac",
    "build:helper": "mkdir -p assets/helper/KeyBlocker.app/Contents/MacOS && swiftc -swift-version 5 -O assets/helper/keyblocker.swift -o assets/helper/KeyBlocker.app/Contents/MacOS/keyblocker && codesign --force --deep --options runtime --sign \"${KEYBLOCKER_CODESIGN_IDENTITY:--}\" --identifier com.jeondowon.rockie.keyblocker assets/helper/KeyBlocker.app"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.31.15"
  },
  "build": {
    "appId": "com.jeondowon.rockie",
    "productName": "Rockie",
    "directories": {
      "output": "dist"
    },
    "files": [
      "!docs/**",
      "!test/**",
      "!scripts/**",
      "!assets/licenses/**",
      "!assets/img/rockie_banner.png"
    ],
    "extraResources": [
      {
        "from": "assets/licenses/THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ],
    "asarUnpack": [
      "assets/helper/**",
      "node_modules/active-win/main",
      "node_modules/active-win/lib/binding/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "LSUIElement": 1,
        "NSAppleEventsUsageDescription": "펫이 Dock 위에 올라설 수 있도록 Dock의 위치와 크기를 읽는 데 사용합니다."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "publish": {
      "provider": "github",
      "owner": "jeondowon",
      "repo": "rockie"
    }
  }
}
